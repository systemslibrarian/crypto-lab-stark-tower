{
  "name": "crypto-lab-stark-tower",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run test:publish-request && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:a11y": "playwright test",
    "deploy": "gh workflow run deploy.yml --repo systemslibrarian/crypto-lab-stark-tower --ref main",
    "test:publish-request": "node --test tests/publish-request.node.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
